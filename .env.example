# ==========================================
# SmartCart Environment Variables (.env)
# ==========================================

# Port for local dev server
PORT=3000

# App URL (auto-populated in Cloud Run, or http://localhost:3000 in local dev)
APP_URL="http://localhost:3000"

# Optional: Razorpay Test Credentials (Defaults to test demo keys if not provided)
RAZORPAY_KEY_ID="rzp_test_SmartCartLiveDemo2026"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# Database Configuration (PostgreSQL / Cloud SQL)
# When running in Cloud SQL / Google Cloud Run, these are automatically provided.
# For local PostgreSQL in VS Code:
SQL_HOST="localhost"
SQL_DB_NAME="smartcart"
SQL_USER="postgres"
SQL_PASSWORD="your_postgres_password"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="your_postgres_password"

# Firebase Client Configuration (matches firebase-applet-config.json)
# Already embedded in firebase-applet-config.json
